<Project>

  <!--
    Settings shared by every project in the repository.
    Update the repository URL below before publishing the package.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Build both net10.0 and net11.0 when the .NET 11+ SDK is present. CI installs both SDKs,
         so both targets are compiled there; a .NET 10-only host still builds net10.0 alone. -->
    <CuiSharpTargetFrameworks>net10.0</CuiSharpTargetFrameworks>
    <CuiSharpTargetFrameworks Condition="'$(NETCoreSdkVersion)' != '' And $([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net10.0;net11.0</CuiSharpTargetFrameworks>
  </PropertyGroup>

  <!-- Package metadata, inherited by every packable project. -->
  <PropertyGroup>
    <Version>0.4.7</Version>
    <Authors>yappologistic</Authors>
    <Copyright>Copyright (c) 2026 yappologistic</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/yappologistic/CuiSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yappologistic/CuiSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject Condition="'$(IsTestProject)' == ''">false</IsTestProject>
  </PropertyGroup>

</Project>
