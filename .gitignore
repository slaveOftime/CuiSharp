# Build output
bin/
obj/
artifacts/
dist/
*.user
*.suo
.vs/
.idea/

# Native artifacts, produced by native/build-native.ps1 or .sh.
# Never committed: they are built from the external/CUI submodule.
native/cui.dll
native/cui.lib
native/libcui.so
native/libcui.a
native/*.exp
native/*.pdb
native/native-provenance.txt

# BenchmarkDotNet scratch
BenchmarkDotNet.Artifacts/

# Test output
TestResults/
*.trx
# Anchored: unanchored, coverage.* also matched Ui/Coverage.g.cs on Windows
# (core.ignoreCase), and the generated wrapper silently never got committed.
/coverage.*
# ...but the binding coverage manifest is generated evidence and is committed.
!bindings/coverage.txt

# Screenshots produced by the CUI_SCREENSHOT hook
*.png
!docs/**/*.png

# Agent harness settings — local to the machine that runs the agent
.pi/

# Editor and OS
.DS_Store
Thumbs.db
*.swp
