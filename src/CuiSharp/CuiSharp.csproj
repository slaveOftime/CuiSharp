<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0 only. The library is statically linked into the app by NativeAOT,
      so a net10 build also serves an app that targets a later TFM.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CuiSharp</RootNamespace>
    <AssemblyName>CuiSharp</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <!-- Not every public member carries a doc comment yet; uncomment to enforce. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>CuiSharp</PackageId>
    <Title>CuiSharp - CUI for .NET</Title>
    <Description>Idiomatic C# bindings for CUI, the 160-component native UI library written in C99. Immediate-mode UI in C#, no XAML and no managed UI framework, with a 1.5 MB NativeAOT single-file output.</Description>
    <PackageTags>cui;ui;gui;native;nativeaot;win32;immediate-mode;interop;desktop</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Native artifacts. A normal build writes them flat into native/: native/build-native.ps1
    on Windows, native/build-native.sh on Linux and macOS. A pack on one machine therefore
    carries that machine's RID only.

    The release packs all RIDs at once, so each platform's artifacts are downloaded into
    their own directory and named here. They cannot share the flat directory: Linux and
    macOS both build a `libcui.a`, and one would overwrite the other.
  -->
  <PropertyGroup>
    <CuiNativeDir>$(MSBuildThisFileDirectory)..\..\native\</CuiNativeDir>
    <CuiNativeRid Condition="'$(CuiNativeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</CuiNativeRid>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Which directory supplies which RID. The shared library names the platform (only
         win builds cui.dll, only linux libcui.so, only osx libcui.dylib); the static
         archive cannot, which is why the flat default is resolved per platform. -->
    <_CuiNativeWin Condition="'$(CuiNativeWinDir)' != ''">$(CuiNativeWinDir)</_CuiNativeWin>
    <_CuiNativeLinux Condition="'$(CuiNativeLinuxDir)' != ''">$(CuiNativeLinuxDir)</_CuiNativeLinux>
    <_CuiNativeOsx Condition="'$(CuiNativeOsxDir)' != ''">$(CuiNativeOsxDir)</_CuiNativeOsx>
    <_CuiNativeWinArm64 Condition="'$(CuiNativeWinArm64Dir)' != ''">$(CuiNativeWinArm64Dir)</_CuiNativeWinArm64>
    <_CuiNativeLinuxArm64 Condition="'$(CuiNativeLinuxArm64Dir)' != ''">$(CuiNativeLinuxArm64Dir)</_CuiNativeLinuxArm64>
    <!-- File names identify the OS, not the CPU. Never label a host ARM64 archive as x64. -->
    <_CuiNativeWin Condition="'$(_CuiNativeWin)' == '' And '$(CuiNativeRid)' == 'win-x64' And Exists('$(CuiNativeDir)cui.dll')">$(CuiNativeDir)</_CuiNativeWin>
    <_CuiNativeLinux Condition="'$(_CuiNativeLinux)' == '' And '$(CuiNativeRid)' == 'linux-x64' And Exists('$(CuiNativeDir)libcui.so')">$(CuiNativeDir)</_CuiNativeLinux>
    <_CuiNativeOsx Condition="'$(_CuiNativeOsx)' == '' And '$(CuiNativeRid)' == 'osx-arm64' And Exists('$(CuiNativeDir)libcui.dylib')">$(CuiNativeDir)</_CuiNativeOsx>
    <_CuiNativeWinArm64 Condition="'$(_CuiNativeWinArm64)' == '' And '$(CuiNativeRid)' == 'win-arm64' And Exists('$(CuiNativeDir)cui.dll')">$(CuiNativeDir)</_CuiNativeWinArm64>
    <_CuiNativeLinuxArm64 Condition="'$(_CuiNativeLinuxArm64)' == '' And '$(CuiNativeRid)' == 'linux-arm64' And Exists('$(CuiNativeDir)libcui.so')">$(CuiNativeDir)</_CuiNativeLinuxArm64>
  </PropertyGroup>

  <ItemGroup Condition="'$(_CuiNativeWin)' != '' And Exists('$(_CuiNativeWin)cui.lib')">
    <None Include="$(_CuiNativeWin)cui.dll" Pack="true" PackagePath="runtimes/win-x64/native/" Visible="false" />
    <!-- The static archive lets a consumer's NativeAOT build link CUI in. -->
    <None Include="$(_CuiNativeWin)cui.lib" Pack="true" PackagePath="runtimes/win-x64/native/" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(_CuiNativeLinux)' != '' And Exists('$(_CuiNativeLinux)libcui.a')">
    <None Include="$(_CuiNativeLinux)libcui.so" Pack="true" PackagePath="runtimes/linux-x64/native/" Visible="false" />
    <None Include="$(_CuiNativeLinux)libcui.a" Pack="true" PackagePath="runtimes/linux-x64/native/" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(_CuiNativeOsx)' != '' And Exists('$(_CuiNativeOsx)libcui.a')">
    <None Include="$(_CuiNativeOsx)libcui.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" Visible="false" />
    <None Include="$(_CuiNativeOsx)libcui.a" Pack="true" PackagePath="runtimes/osx-arm64/native/" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(_CuiNativeWinArm64)' != '' And Exists('$(_CuiNativeWinArm64)cui.lib')">
    <None Include="$(_CuiNativeWinArm64)cui.dll" Pack="true" PackagePath="runtimes/win-arm64/native/" Visible="false" />
    <None Include="$(_CuiNativeWinArm64)cui.lib" Pack="true" PackagePath="runtimes/win-arm64/native/" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(_CuiNativeLinuxArm64)' != '' And Exists('$(_CuiNativeLinuxArm64)libcui.a')">
    <None Include="$(_CuiNativeLinuxArm64)libcui.so" Pack="true" PackagePath="runtimes/linux-arm64/native/" Visible="false" />
    <None Include="$(_CuiNativeLinuxArm64)libcui.a" Pack="true" PackagePath="runtimes/linux-arm64/native/" Visible="false" />
  </ItemGroup>

  <!--
    Hosting (builder, Component, Mutation) ships inside this package. Trimming and
    NativeAOT remove it — and its dependency — from apps that never reference it,
    which is why it does not need a package of its own.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CuiSharp.Tests" />
    <InternalsVisibleTo Include="CuiSharp.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\CuiSharp.targets" Pack="true" PackagePath="build/" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!--
      The skill folder is the whole of what an app needs, and it ships at the path it has in the
      repository so a relative link works in both. Nothing else has to be packed with it: the pages it
      links to are in it (skills/cui-dotnet/SKILL.md is the entry point; there is no other README).
    -->
    <None Include="..\..\skills\cui-dotnet\**\*.md" Pack="true" PackagePath="skills/cui-dotnet/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
    <None Include="..\..\skills\cui-dotnet\llms.txt" Pack="true" PackagePath="skills/cui-dotnet/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../CuiSharp.Analyzers/CuiSharp.Analyzers.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <None Include="$(MSBuildThisFileDirectory)../CuiSharp.Analyzers/bin/$(Configuration)/netstandard2.0/CuiSharp.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CuiSharp.CodeFixes/CuiSharp.CodeFixes.csproj" ReferenceOutputAssembly="false" />
    <None Include="../CuiSharp.CodeFixes/bin/$(Configuration)/netstandard2.0/CuiSharp.CodeFixes.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <!--
    What went into the package, recorded rather than assumed: each native file with its RID and
    SHA-256, plus whatever the native build wrote about the revision and compiler that produced
    it. A consumer that hits an ABI mismatch can read this instead of bisecting releases.
  -->
  <PropertyGroup>
    <!-- Pack calls this per framework, which is how a file that only exists after a build gets in. -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CuiSharpPackNativeProvenance</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="CuiSharpPackNativeProvenance">
    <ItemGroup>
      <_CuiPackagedNative Include="$(_CuiNativeWin)cui.dll" Condition="'$(_CuiNativeWin)' != '' And Exists('$(_CuiNativeWin)cui.dll')" Rid="win-x64" />
      <_CuiPackagedNative Include="$(_CuiNativeWin)cui.lib" Condition="'$(_CuiNativeWin)' != '' And Exists('$(_CuiNativeWin)cui.lib')" Rid="win-x64" />
      <_CuiPackagedNative Include="$(_CuiNativeLinux)libcui.so" Condition="'$(_CuiNativeLinux)' != '' And Exists('$(_CuiNativeLinux)libcui.so')" Rid="linux-x64" />
      <_CuiPackagedNative Include="$(_CuiNativeLinux)libcui.a" Condition="'$(_CuiNativeLinux)' != '' And Exists('$(_CuiNativeLinux)libcui.a')" Rid="linux-x64" />
      <_CuiPackagedNative Include="$(_CuiNativeWinArm64)cui.dll" Condition="'$(_CuiNativeWinArm64)' != '' And Exists('$(_CuiNativeWinArm64)cui.dll')" Rid="win-arm64" />
      <_CuiPackagedNative Include="$(_CuiNativeWinArm64)cui.lib" Condition="'$(_CuiNativeWinArm64)' != '' And Exists('$(_CuiNativeWinArm64)cui.lib')" Rid="win-arm64" />
      <_CuiPackagedNative Include="$(_CuiNativeLinuxArm64)libcui.so" Condition="'$(_CuiNativeLinuxArm64)' != '' And Exists('$(_CuiNativeLinuxArm64)libcui.so')" Rid="linux-arm64" />
      <_CuiPackagedNative Include="$(_CuiNativeLinuxArm64)libcui.a" Condition="'$(_CuiNativeLinuxArm64)' != '' And Exists('$(_CuiNativeLinuxArm64)libcui.a')" Rid="linux-arm64" />
      <_CuiPackagedNative Include="$(_CuiNativeOsx)libcui.dylib" Condition="'$(_CuiNativeOsx)' != '' And Exists('$(_CuiNativeOsx)libcui.dylib')" Rid="osx-arm64" />
      <_CuiPackagedNative Include="$(_CuiNativeOsx)libcui.a" Condition="'$(_CuiNativeOsx)' != '' And Exists('$(_CuiNativeOsx)libcui.a')" Rid="osx-arm64" />
    </ItemGroup>

    <GetFileHash Files="@(_CuiPackagedNative)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_CuiHashedNative" />
    </GetFileHash>

    <ItemGroup>
      <_CuiProvenanceLine Include="CuiSharp $(Version) native artifacts" />
      <_CuiProvenanceLine Include="@(_CuiHashedNative->'%(Rid) %(Filename)%(Extension) %(FileHash)')" />
      <_CuiProvenanceLine Include="repository $(RepositoryUrl) @ $(SourceRevisionId)" Condition="'$(SourceRevisionId)' != ''" />
    </ItemGroup>

    <!-- ReadAllLines is not a property function MSBuild will run, so the native build's own
         revision and compiler lines arrive through a task, appended after the header above. -->
    <ReadLinesFromFile File="$(_CuiNativeWin)native-provenance.txt" Condition="'$(_CuiNativeWin)' != '' And Exists('$(_CuiNativeWin)native-provenance.txt')">
      <Output TaskParameter="Lines" ItemName="_CuiWinProvenance" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(_CuiNativeWinArm64)native-provenance.txt" Condition="'$(_CuiNativeWinArm64)' != '' And Exists('$(_CuiNativeWinArm64)native-provenance.txt')">
      <Output TaskParameter="Lines" ItemName="_CuiWinArmProvenance" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(_CuiNativeLinux)native-provenance.txt" Condition="'$(_CuiNativeLinux)' != '' And Exists('$(_CuiNativeLinux)native-provenance.txt')">
      <Output TaskParameter="Lines" ItemName="_CuiLinuxProvenance" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(_CuiNativeLinuxArm64)native-provenance.txt" Condition="'$(_CuiNativeLinuxArm64)' != '' And Exists('$(_CuiNativeLinuxArm64)native-provenance.txt')">
      <Output TaskParameter="Lines" ItemName="_CuiLinuxArmProvenance" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(_CuiNativeOsx)native-provenance.txt" Condition="'$(_CuiNativeOsx)' != '' And Exists('$(_CuiNativeOsx)native-provenance.txt')">
      <Output TaskParameter="Lines" ItemName="_CuiOsxProvenance" />
    </ReadLinesFromFile>
    <ItemGroup>
      <!-- Retain the build's RID stamp: unlike the file name it identifies the CPU, including
           a cross-built archive or an emulated SDK. Refuse to relabel it while packing. -->
      <_CuiBuiltRid Include="@(_CuiWinProvenance)" ExpectedRid="win-x64" Condition="$([System.String]::Copy('%(_CuiWinProvenance.Identity)').StartsWith('rid='))" />
      <_CuiBuiltRid Include="@(_CuiWinArmProvenance)" ExpectedRid="win-arm64" Condition="$([System.String]::Copy('%(_CuiWinArmProvenance.Identity)').StartsWith('rid='))" />
      <_CuiBuiltRid Include="@(_CuiLinuxProvenance)" ExpectedRid="linux-x64" Condition="$([System.String]::Copy('%(_CuiLinuxProvenance.Identity)').StartsWith('rid='))" />
      <_CuiBuiltRid Include="@(_CuiLinuxArmProvenance)" ExpectedRid="linux-arm64" Condition="$([System.String]::Copy('%(_CuiLinuxArmProvenance.Identity)').StartsWith('rid='))" />
      <_CuiBuiltRid Include="@(_CuiOsxProvenance)" ExpectedRid="osx-arm64" Condition="$([System.String]::Copy('%(_CuiOsxProvenance.Identity)').StartsWith('rid='))" />
      <_CuiProvenanceLine Include="@(_CuiWinProvenance->'win-x64 %(Identity)')" />
      <_CuiProvenanceLine Include="@(_CuiWinArmProvenance->'win-arm64 %(Identity)')" />
      <_CuiProvenanceLine Include="@(_CuiLinuxProvenance->'linux-x64 %(Identity)')" />
      <_CuiProvenanceLine Include="@(_CuiLinuxArmProvenance->'linux-arm64 %(Identity)')" />
      <_CuiProvenanceLine Include="@(_CuiOsxProvenance->'osx-arm64 %(Identity)')" />
    </ItemGroup>

    <Error Condition="'@(_CuiBuiltRid)' != '' And '%(_CuiBuiltRid.Identity)' != 'rid=%(_CuiBuiltRid.ExpectedRid)'"
           Text="Native build declares %(_CuiBuiltRid.Identity), but would be packaged as %(_CuiBuiltRid.ExpectedRid). Use the matching CuiNative*Dir or CuiNativeRid; do not relabel an archive from another CPU." />

    <WriteLinesToFile File="$(IntermediateOutputPath)native-provenance.txt"
                      Lines="@(_CuiProvenanceLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <TfmSpecificPackageFile Include="$(IntermediateOutputPath)native-provenance.txt">
        <PackagePath>runtimes/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <Target Name="CuiSharpWarnMissingNative" BeforeTargets="Pack" Condition="'$(_CuiNativeWin)$(_CuiNativeWinArm64)$(_CuiNativeLinux)$(_CuiNativeLinuxArm64)$(_CuiNativeOsx)' == ''">
    <Warning Text="No native artifacts found - the package will contain managed code only. Run the host's native/build-native script first." />
  </Target>

</Project>
