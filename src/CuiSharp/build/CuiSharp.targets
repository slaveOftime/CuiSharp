<Project>

  <!--
    Shipping targets, imported by consumers of the CuiSharp package.

    The package already puts cui.dll under runtimes/win-x64/native/, which the
    .NET host resolves for [DllImport("cui")] on its own. This file adds the
    second half: when the consumer publishes with NativeAOT, point the compiler
    at the packaged static archive so CUI is linked into the executable instead
    of being loaded at runtime.
  -->

  <PropertyGroup>
    <_CuiSharpNativeWin>$(MSBuildThisFileDirectory)../runtimes/win-x64/native/</_CuiSharpNativeWin>
    <_CuiSharpNativeLinux>$(MSBuildThisFileDirectory)../runtimes/linux-x64/native/</_CuiSharpNativeLinux>
    <_CuiSharpNativeOsx>$(MSBuildThisFileDirectory)../runtimes/osx-arm64/native/</_CuiSharpNativeOsx>
    <!-- RID wins; a publish without one falls back to the host's own archive. -->
    <_CuiSharpRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_CuiSharpRid>
    <_CuiSharpRid Condition="'$(_CuiSharpRid)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win</_CuiSharpRid>
    <_CuiSharpRid Condition="'$(_CuiSharpRid)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">linux</_CuiSharpRid>
    <_CuiSharpRid Condition="'$(_CuiSharpRid)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">osx</_CuiSharpRid>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true' And $(_CuiSharpRid.StartsWith('win')) And Exists('$(_CuiSharpNativeWin)cui.lib')">
    <DirectPInvoke Include="cui" />
    <NativeLibrary Include="$(_CuiSharpNativeWin)cui.lib" />

    <!-- What CUI's Win32 backend links against. -->
    <LinkerArg Include="user32.lib" />
    <LinkerArg Include="gdi32.lib" />
    <LinkerArg Include="opengl32.lib" />
    <LinkerArg Include="shell32.lib" />
    <LinkerArg Include="imm32.lib" />
    <LinkerArg Include="dwmapi.lib" />
    <LinkerArg Include="comdlg32.lib" />
    <LinkerArg Include="ole32.lib" />
    <LinkerArg Include="/OPT:REF" />
    <LinkerArg Include="/OPT:ICF" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true' And $(_CuiSharpRid.StartsWith('linux')) And Exists('$(_CuiSharpNativeLinux)libcui.a')">
    <DirectPInvoke Include="cui" />
    <NativeLibrary Include="$(_CuiSharpNativeLinux)libcui.a" />

    <!-- CUI dlopens GL, so the X11 backend needs only Xlib and the C runtime. -->
    <LinkerArg Include="-lX11" />
    <LinkerArg Include="-ldl" />
    <LinkerArg Include="-lpthread" />
    <LinkerArg Include="-lm" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true' And $(_CuiSharpRid.StartsWith('osx')) And Exists('$(_CuiSharpNativeOsx)libcui.a')">
    <DirectPInvoke Include="cui" />
    <NativeLibrary Include="$(_CuiSharpNativeOsx)libcui.a" />

    <!-- What CUI's Cocoa backend links against. -->
    <LinkerArg Include="-framework Cocoa" />
    <LinkerArg Include="-framework QuartzCore" />
    <LinkerArg Include="-framework OpenGL" />
  </ItemGroup>

  <!--
    AOT links CUI into the executable, so the shared library and the archive beside it are noise in
    a publish folder whose promise is "one file".
  -->
  <Target Name="CuiSharpDropNativeFilesFromAotPublish"
          AfterTargets="Publish"
          Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <_CuiSharpStrayNative Include="$(PublishDir)cui.dll;$(PublishDir)cui.lib" />
    </ItemGroup>
    <Message Importance="normal" Text="CuiSharp: AOT publish, removing @(_CuiSharpStrayNative->Count()) native file(s) from $(PublishDir)" />
    <Delete Files="@(_CuiSharpStrayNative)" ContinueOnError="true" />
  </Target>

  <Target Name="CuiSharpExplainMissingArchive"
          BeforeTargets="PrepareForPublish"
          Condition="'$(PublishAot)' == 'true' And !Exists('$(_CuiSharpNativeWin)cui.lib') And !Exists('$(_CuiSharpNativeLinux)libcui.a') And !Exists('$(_CuiSharpNativeOsx)libcui.a')">
    <Message Importance="high"
             Text="CuiSharp: the static archive for this platform is not in the package, so CUI will be loaded from its shared library at runtime. Add &lt;DirectPInvoke Include=&quot;cui&quot; /&gt; and a NativeLibrary item yourself to link it statically." />
  </Target>

</Project>
