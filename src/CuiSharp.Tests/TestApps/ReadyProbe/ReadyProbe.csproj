<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A benign probe app used only by the tool's real-process tests. It is deliberately not in
    the solution: `dotnet cui` builds this directly by path, exactly the way a user builds their
    app, so the test exercises the whole chain — build, start, wait, command — rather than a
    mock.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>ReadyProbe</AssemblyName>
    <RootNamespace>ReadyProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\CuiSharp\CuiSharp.csproj" />
  </ItemGroup>

  <!--
    The native payload must sit next to the probe the way the package places it next to a real
    app: the probe is launched from scratch working directories by the fixture-isolation test,
    so inheriting the launcher's cwd would mask a missing copy. Four levels up reaches the
    repository root from src/CuiSharp.Tests/TestApps/ReadyProbe.
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\native\cui.dll')">
    <None Include="..\..\..\..\native\cui.dll" Link="cui.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\native\libcui.so')">
    <None Include="..\..\..\..\native\libcui.so" Link="libcui.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\native\libcui.dylib')">
    <None Include="..\..\..\..\native\libcui.dylib" Link="libcui.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
