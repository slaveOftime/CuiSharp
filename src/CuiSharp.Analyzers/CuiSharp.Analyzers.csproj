<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Analyzers ship inside the CuiSharp package (analyzers/dotnet/cs), so they target
      netstandard2.0: that is what every compiler version can load. They are never a
      runtime dependency of an app.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <AssemblyName>CuiSharp.Analyzers</AssemblyName>
    <RootNamespace>CuiSharp.Analyzers</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Release tracking is a package-maintenance rule the framework does not need. -->
    <NoWarn>$(NoWarn);CS1591;RS2008</NoWarn>
  </PropertyGroup>

</Project>
