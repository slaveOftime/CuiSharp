<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <AssemblyName>CuiSharp.Benchmarks</AssemblyName>
    <RootNamespace>CuiSharp.Benchmarks</RootNamespace>
    <!-- BenchmarkDotNet wants a plain Debuggable build; it re-jits per job. -->
    <Optimize>true</Optimize>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CuiSharp\CuiSharp.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\cui.dll')">
    <None Include="..\..\native\cui.dll" Link="cui.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\libcui.so')">
    <None Include="..\..\native\libcui.so" Link="libcui.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\libcui.dylib')">
    <None Include="..\..\native\libcui.dylib" Link="libcui.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
