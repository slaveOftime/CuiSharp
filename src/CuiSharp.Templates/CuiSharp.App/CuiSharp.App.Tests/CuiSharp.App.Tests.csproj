<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>CuiSharp.App.Tests</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No Condition here: dotnet new evaluates a condition on its own CuiSharpVersion
         symbol and drops the line, which leaves the package reference without a version. -->
    <CuiSharpVersion>__CUISHARP_VERSION__</CuiSharpVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The app's package reference brings CuiSharp in too, so this project only adds the app. -->
  <ItemGroup>
    <ProjectReference Include="..\CuiSharp.App\CuiSharp.App.csproj" />
  </ItemGroup>

  <!-- Only needed when CuiSharp is not already coming in with the app project. -->
  <ItemGroup Condition="'$(UseLocalCuiSharp)' != 'true'">
    <PackageReference Include="CuiSharp" Version="$(CuiSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
