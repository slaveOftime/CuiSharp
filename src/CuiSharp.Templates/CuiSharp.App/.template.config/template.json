{
  "$schema": "http://json.schemastore.org/template",
  "author": "yappologistic",
  "classifications": [ "CuiSharp", "Desktop", "UI" ],
  "identity": "CuiSharp.App",
  "name": "CuiSharp desktop app",
  "shortName": "cui-app",
  "sourceName": "CuiSharp.App",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/[Bb]in/**",
            "**/[Oo]bj/**"
          ]
        },
        {
          "condition": "(NoMarkets)",
          "exclude": [
            "CuiSharp.App/Pages/MarketsPage.cs",
            "CuiSharp.App/Services/MarketFeed.cs",
            "CuiSharp.App/Services/PriceFeed.cs",
            "CuiSharp.App/Services/PriceHistory.cs",
            "CuiSharp.App.Tests/MarketTestData.cs",
            "CuiSharp.App.Tests/Pages/MarketsPageTests.cs",
            "CuiSharp.App.Tests/Services/MarketFeedTests.cs",
            "CuiSharp.App.Tests/Services/PriceHistoryTests.cs"
          ]
        }
      ]
    }
  ],
  "symbols": {
    "CuiSharpVersion": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "__CUISHARP_VERSION__",
      "defaultValue": "0.5.0",
      "description": "The CuiSharp package version the generated solution references. Defaults to the version this template shipped with."
    },
    "NoMarkets": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Generate only the Todo starter, without the Markets example or its tests."
    }
  },
  "description": "A native desktop app in plain C# with CUI. Follow a Todo interaction from source to UI tree and headless test; explore the separate Markets tab for live data and zero-allocation draws."
}
