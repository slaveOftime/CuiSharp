<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <!-- Replace this .ico file and rebuild to change both the executable and window icon. -->
    <ApplicationIcon>CuiSharp.App.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CuiSharp.App</RootNamespace>
    <!-- IsOSPlatform avoids dotnet new evaluating $(OS) at scaffold time. -->
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Unconditional: dotnet new evaluates a Condition naming a template symbol and drops false lines. -->
    <CuiSharpVersion>__CUISHARP_VERSION__</CuiSharpVersion>
  </PropertyGroup>

  <!-- In-repo builds use Directory.Build.targets; scaffolded apps use the NuGet package. -->
  <ItemGroup Condition="'$(UseLocalCuiSharp)' != 'true'">
    <PackageReference Include="CuiSharp" Version="$(CuiSharpVersion)" />
  </ItemGroup>

  <!-- Single-file NativeAOT: dotnet publish -c Release -r win-x64 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
