<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The app shapes tools/size-report.ps1 measures. One project, one shape per build:
    -p:Shape=MIN|TABLE|CHART|FORM|RICH picks the #if block in Program.cs.

    Deliberately not in CuiSharp.slnx: it is a measuring instrument, not a deliverable, and
    it must be able to publish with a property set a user's app would never set. Like
    CuiSharp.Benchmarks it is built by hand (tools/size-report.ps1), not by the solution.

    Nothing here comes from Directory.Build.targets: that file wires the template's project
    names to the local native library, and this project is not one of them.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SizeMatrix</RootNamespace>
    <AssemblyName>Shape$(Shape)</AssemblyName>
    <DefineConstants Condition="'$(Shape)' != ''">$(DefineConstants);$(Shape)</DefineConstants>
    <CuiNativeLib Condition="'$(CuiNativeLib)' == ''">..\..\native\cui.lib</CuiNativeLib>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CuiSharp\CuiSharp.csproj" />
  </ItemGroup>


  <!-- The same publish profile the template and the gallery use. Nothing that belongs to the
       package's size profile is restated here: that file is imported below. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!-- CUI is linked from the static archive, exactly as the package does for a consumer. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true' And $([MSBuild]::IsOSPlatform('Windows'))">
    <DirectPInvoke Include="cui" />
    <NativeLibrary Include="$(CuiNativeLib)" />
    <LinkerArg Include="user32.lib" />
    <LinkerArg Include="gdi32.lib" />
    <LinkerArg Include="opengl32.lib" />
    <LinkerArg Include="shell32.lib" />
    <LinkerArg Include="imm32.lib" />
    <LinkerArg Include="dwmapi.lib" />
    <LinkerArg Include="comdlg32.lib" />
    <LinkerArg Include="ole32.lib" />
    <LinkerArg Include="/OPT:REF" />
    <LinkerArg Include="/OPT:ICF" />
  </ItemGroup>

  <!--
    The size profile is imported, not restated: a tool that measured a copy of the switches would
    keep passing after the package changed them. -p:CuiSharpSizeProfile=false
    -p:CuiSharpHeadless=true is the width that shows what the profile is worth.

    Last in the file, where NuGet puts the package's own build targets: the profile decides from
    PublishAot and RuntimeIdentifier, so it has to see them set.
  -->
  <Import Project="..\..\src\CuiSharp\build\CuiSharp.Size.targets" />

</Project>
